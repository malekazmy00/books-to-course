<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only (the API is served by Tailscale Serve with a Let's Encrypt certificate, D-030).
     Trust: the system store plus ISRG Root X1 and X2. Android 7.0 (API 24) trusts neither ISRG root
     (X1 arrived in 7.1.1, X2 in 14) and the DST Root CA X3 cross-sign expired on 2024-09-30, so
     without these anchors API 24 rejects the server. Sources and fingerprints:
     android/learner-app/README.md, section "Android 7". -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
