        "additionalProperties": false,
        "type": "object",
        "required": [
          "courses"
        ],
        "title": "CourseList"
      },
      "CourseSummary": {
        "properties": {
          "course_id": {
            "type": "string",
            "title": "Course Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "episode_count": {
            "type": "integer",
