            "default": []
          },
          "first_lesson_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Lesson Id"
          },
          "first_episode": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Episode"
          },
          "relations": {
            "items": {
              "$ref": "#/components/schemas/ConceptRelationOut"
            },
            "type": "array",
            "title": "Relations",
            "default": []
