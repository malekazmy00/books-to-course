{
  "openapi": "3.1.0",
  "info": {
    "title": "Book2Course Learner API",
    "description": "Read-only learner API (tailnet-only, bearer token, D-030). Serves accepted artifacts only; no GET response contains an answer.",
    "version": "3.0.0"
  },
  "paths": {
    "/v3/learner/meta": {
      "get": {
        "tags": [
          "learner"
        ],
        "summary": "Learner Meta",
        "operationId": "learner_meta_v3_learner_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearnerMeta"
                }
              }
            }
          }
        }
      }
    },
    "/v3/learner/courses": {
      "get": {
        "tags": [
          "learner"
        ],
        "summary": "Learner Courses",
        "operationId": "learner_courses_v3_learner_courses_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseList"
                }
              }
            }
          }
        }
      }
    },
    "/v3/learner/courses/{course_id}": {
      "get": {
        "tags": [
          "learner"
        ],
        "summary": "Learner Course",
        "operationId": "learner_course_v3_learner_courses__course_id__get",
        "parameters": [
          {
            "name": "course_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Course Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v3/learner/courses/{course_id}/episodes/{number}": {
      "get": {
        "tags": [
          "learner"
        ],
        "summary": "Learner Episode",
        "operationId": "learner_episode_v3_learner_courses__course_id__episodes__number__get",
        "parameters": [
          {
            "name": "course_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Course Id"
            }
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EpisodeDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v3/learner/courses/{course_id}/episodes/{number}/questions/{question_id}/reveal": {
      "post": {
        "tags": [
          "learner"
        ],
        "summary": "Learner Reveal",
        "operationId": "learner_reveal_v3_learner_courses__course_id__episodes__number__questions__question_id__reveal_post",
        "parameters": [
          {
            "name": "course_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Course Id"
            }
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Number"
            }
          },
          {
            "name": "question_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Question Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevealRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevealResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v3/learner/courses/{course_id}/episodes/{number}/audio": {
      "get": {
        "tags": [
          "learner"
        ],
        "summary": "Learner Episode Audio",
        "operationId": "learner_episode_audio_v3_learner_courses__course_id__episodes__number__audio_get",
        "parameters": [
          {
            "name": "course_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Course Id"
            }
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              },
              "audio/mpeg": {}
            }
          },
          "206": {
            "content": {
              "audio/mpeg": {}
            },
            "description": "Partial Content"
          },
          "404": {
            "description": "no accepted audio for this episode yet"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v3/learner/courses/{course_id}/concepts": {
      "get": {
        "tags": [
          "learner"
        ],
        "summary": "Learner Concepts",
        "operationId": "learner_concepts_v3_learner_courses__course_id__concepts_get",
        "parameters": [
          {
            "name": "course_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Course Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConceptList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthorQuote": {
        "properties": {
          "quote": {
            "type": "string",
            "title": "Quote"
          },
          "pages": {
