        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "quote"
        ],
        "title": "AuthorQuote"
      },
      "ConceptCard": {
        "properties": {
          "concept_id": {
            "type": "string",
            "title": "Concept Id"
          },
          "term": {
            "type": "string",
