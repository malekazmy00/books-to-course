        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "concept_id",
          "term",
          "kind"
        ],
        "title": "ConceptCard"
      },
      "ConceptList": {
        "properties": {
          "course_id": {
            "type": "string",
