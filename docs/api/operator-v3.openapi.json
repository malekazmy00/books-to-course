    "title": "Book2Course Operator API",
    "description": "Read-only stages and progress of every book on the new path (tailnet-only, bearer token, D-030). No route changes anything.",
    "version": "1.0.0"
  },
  "paths": {
    "/v3/operator/meta": {
      "get": {
        "tags": [
          "operator"
        ],
        "summary": "Operator Meta",
        "operationId": "operator_meta_v3_operator_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorMeta"
                }
              }
            }
          }
        }
      }
    },
    "/v3/operator/books": {
      "get": {
        "tags": [
          "operator"
        ],
        "summary": "Operator Books",
        "operationId": "operator_books_v3_operator_books_get",
